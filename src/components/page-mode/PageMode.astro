---
// src/components/page-mode/PageMode.astro
// Light / dark mode toggle button.
// Shows the sun in light mode and the moon in dark mode (pure CSS via the
// `dark:` variant, so the right icon is shown on first paint).
// Requires <PageModeScript /> in the <head> to apply the saved theme early.
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils/cn";

export interface Props extends Omit<HTMLAttributes<"button">, "type"> {
  /** Accessible name for the button. */
  label?: string;
}

const { label = "Dark mode", class: className, ...props } = Astro.props;
---

<button
  type="button"
  data-page-mode-toggle
  aria-label={label}
  aria-pressed="false"
  class={cn(
    "inline-flex size-10 cursor-pointer items-center justify-center rounded-full text-ink transition-colors hover:bg-primary-tint",
    className,
  )}
  {...props}
>
  <!-- Sun (light mode) -->
  <svg
    class="size-5 dark:hidden"
    fill="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12,18.09A6.09,6.09,0,1,1,18.09,12,6.1,6.1,0,0,1,12,18.09ZM12,6.91A5.09,5.09,0,1,0,17.09,12,5.1,5.1,0,0,0,12,6.91Z"></path>
    <path d="M11.5,2.568v1.6a.5.5,0,1,0,1,0v-1.6a.5.5,0,1,0-1,0Z"></path>
    <path d="M12.5,21.432v-1.6a.5.5,0,0,0-1,0v1.6a.5.5,0,1,0,1,0Z"></path>
    <path d="M21.432,11.5h-1.6a.5.5,0,0,0,0,1h1.6a.5.5,0,1,0,0-1Z"></path>
    <path d="M2.568,12.5h1.6a.5.5,0,1,0,0-1h-1.6a.5.5,0,1,0,0,1Z"></path>
    <path d="M18.316,4.977l-.992.992-.141.141a.514.514,0,0,0-.146.353.508.508,0,0,0,.146.354.5.5,0,0,0,.354.146.515.515,0,0,0,.353-.146l.992-.992.141-.141a.515.515,0,0,0,.147-.354.508.508,0,0,0-.147-.353.5.5,0,0,0-.353-.147.522.522,0,0,0-.354.147Z"></path>
    <path d="M5.684,19.023l.992-.992.141-.141a.514.514,0,0,0,.146-.353.508.508,0,0,0-.146-.354.5.5,0,0,0-.354-.146.515.515,0,0,0-.353.146l-.992.992-.141.141a.515.515,0,0,0-.147.354.508.508,0,0,0,.147.353.5.5,0,0,0,.353.147.522.522,0,0,0,.354-.147Z"></path>
    <path d="M19.023,18.316l-.992-.992-.141-.141a.514.514,0,0,0-.353-.146.508.508,0,0,0-.354.146.5.5,0,0,0-.146.354.515.515,0,0,0,.146.353l.992.992.141.141a.515.515,0,0,0,.354.147.508.508,0,0,0,.353-.147.5.5,0,0,0,.147-.353.522.522,0,0,0-.147-.354Z"></path>
    <path d="M4.977,5.684l.992.992.141.141a.514.514,0,0,0,.353.146.508.508,0,0,0,.354-.146.5.5,0,0,0,.146-.354.515.515,0,0,0-.146-.353l-.992-.992-.141-.141A.515.515,0,0,0,5.33,4.83a.508.508,0,0,0-.353.147.5.5,0,0,0-.147.353.522.522,0,0,0,.147.354Z"></path>
  </svg>

  <!-- Moon (dark mode) -->
  <svg
    class="hidden size-5 dark:block"
    fill="currentColor"
    viewBox="0 0 24 24"
    xmlns="http://www.w3.org/2000/svg"
    aria-hidden="true"
    focusable="false"
  >
    <path d="M12.741,20.917a9.389,9.389,0,0,1-1.395-.105,9.141,9.141,0,0,1-1.465-17.7,1.177,1.177,0,0,1,1.21.281,1.273,1.273,0,0,1,.325,1.293,8.112,8.112,0,0,0-.353,2.68,8.266,8.266,0,0,0,4.366,6.857,7.628,7.628,0,0,0,3.711.993,1.242,1.242,0,0,1,.994,1.963h0A9.148,9.148,0,0,1,12.741,20.917ZM10.261,4.05a.211.211,0,0,0-.065.011,8.137,8.137,0,1,0,9.131,12.526h0a.224.224,0,0,0,.013-.235.232.232,0,0,0-.206-.136A8.619,8.619,0,0,1,14.946,15.1a9.274,9.274,0,0,1-4.883-7.7,9.123,9.123,0,0,1,.4-3.008.286.286,0,0,0-.069-.285A.184.184,0,0,0,10.261,4.05Z"></path>
  </svg>
</button>

<script>
  // Bundled once per page, however many toggles are rendered.
  const STORAGE_KEY = "theme";
  type Theme = "light" | "dark";

  const root = document.documentElement;
  const media = window.matchMedia("(prefers-color-scheme: dark)");

  const current = (): Theme => (root.dataset.theme === "dark" ? "dark" : "light");

  function getStored(): Theme | null {
    try {
      const value = localStorage.getItem(STORAGE_KEY);
      return value === "light" || value === "dark" ? value : null;
    } catch {
      return null;
    }
  }

  function syncButtons() {
    const isDark = current() === "dark";
    document
      .querySelectorAll<HTMLButtonElement>("[data-page-mode-toggle]")
      .forEach((btn) => btn.setAttribute("aria-pressed", String(isDark)));
  }

  function apply(theme: Theme, persist = false) {
    root.dataset.theme = theme;
    root.style.colorScheme = theme;
    if (persist) {
      try {
        localStorage.setItem(STORAGE_KEY, theme);
      } catch {
        /* storage unavailable: theme still applies for this page */
      }
    }
    syncButtons();
  }

  // One delegated listener handles every toggle on the page.
  document.addEventListener("click", (event) => {
    const target = event.target as Element | null;
    if (!target?.closest("[data-page-mode-toggle]")) return;
    apply(current() === "dark" ? "light" : "dark", true);
  });

  // Follow the OS setting until the visitor makes their own choice.
  media.addEventListener("change", (event) => {
    if (!getStored()) apply(event.matches ? "dark" : "light");
  });

  // Keep other open tabs in sync.
  window.addEventListener("storage", (event) => {
    if (event.key !== STORAGE_KEY) return;
    apply(getStored() ?? (media.matches ? "dark" : "light"));
  });

  syncButtons();
  document.addEventListener("astro:page-load", syncButtons);
</script>
