---
/**
 * GetDirectionsButton.astro — ripple-pin icon, "Get Directions", address below.
 * Values are hard-coded. Opens Google Maps in a new tab.
 *
 * <GetDirectionsButton />
 * <GetDirectionsButton class="text-white" />
 */
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils/cn";

type Props = Omit<HTMLAttributes<"a">, "href">;

const { class: className, ...rest } = Astro.props;

const MAP_URL =
  "https://www.google.com/maps/search/?api=1&query=22040+Township+Rd+522%2C+Sherwood+Park%2C+AB";
---

<a
  href={MAP_URL}
  target="_blank"
  rel="noopener noreferrer"
  class={cn(
    "flex items-center gap-1 whitespace-nowrap text-[#2b8a2e] no-underline hover:text-[#0f4b39]",
    className,
  )}
  {...rest}
>
  <!-- <svg
    width="40"
    height="40"
    viewBox="0 0 48 48"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >
    <path d="M24 34s-9-8.5-9-16a9 9 0 0 1 18 0c0 7.5-9 16-9 16z" />
    <circle cx="24" cy="18" r="3.2" />
    <path d="M12 33c-3 1-4.5 2.3-4.5 3.7 0 3 7.4 5.3 16.5 5.3s16.5-2.3 16.5-5.3c0-1.4-1.5-2.7-4.5-3.7" />
    <path d="M18 37.5c1.8.4 3.8.5 6 .5s4.2-.1 6-.5" />
  </svg> -->
  <span>
    <span class="block text-xs font-bold uppercase tracking-[.3px] text-olive-900">
      Get Directions
    </span>

    <span class="block text-[13px] leading-snug text-[#4a5a50]">
      Sherwood Park, Alberta
    </span>
  </span>
  <span class="sr-only">(opens in a new tab)</span>
</a>
