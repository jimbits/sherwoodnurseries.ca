---
/**
 * VisitDialog.astro — "Plan your visit": live open/closed status, weekly
 * hours, season dates, address and directions in one modal.
 *
 * Rendered ONCE (in Layout.astro). Anything with `data-visit-open` opens it,
 * e.g. the hero's Plan your visit link.
 *
 * <button type="button" data-visit-open aria-haspopup="dialog">…</button>
 */
import { business, mapsLinks } from "@/data/business";
import { getVisitStatus, season, formatDate } from "@/data/hours";
import HoursList from "./HoursList.astro";
import HeroIcon from "@/components/blocks/hero/HeroIcon.astro";

const status = getVisitStatus(); // build-time; refreshed in the browser
---

<dialog
  id="visit-dialog"
  aria-labelledby="visit-dialog-title"
  data-visit-dialog
  class="visit-dialog m-auto w-[min(44rem,calc(100%-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-lg border border-sherwood-forest/10 bg-sherwood-paper p-0 text-sherwood-forest shadow-float"
>
  <div class="flex items-start justify-between gap-4 px-6 pt-6 sm:px-8 sm:pt-8">
    <div>
      <p class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-wider">
        <HeroIcon name="leaf" class="size-4 text-sherwood-leaf" />
        Visit the nursery
      </p>
      <h2 id="visit-dialog-title" class="mt-2 text-[28px] font-bold leading-tight tracking-tight">
        Plan your visit
      </h2>
      <p
        class="group/status mt-3 flex items-start gap-2.5 text-[16px]"
        data-visit-status
        data-open={String(status.open)}
      >
        <span
          class="mt-[0.45em] size-2.5 shrink-0 rounded-full border-2 border-sherwood-leaf group-data-[open=true]/status:bg-sherwood-leaf"
          aria-hidden="true"></span>
        <span>
          <span data-visit-label class="font-semibold">{status.label}</span>
          <span aria-hidden="true"> · </span>
          <span data-visit-detail class="text-sherwood-forest-soft">{status.detail}</span>
        </span>
      </p>
    </div>
    <button
      type="button"
      data-visit-close
      aria-label="Close plan your visit"
      class="grid size-11 shrink-0 cursor-pointer place-items-center rounded-pill text-sherwood-forest-soft transition-colors hover:bg-sherwood-mint hover:text-sherwood-forest"
    >
      <svg viewBox="0 0 24 24" class="size-5" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true">
        <path d="M6 6l12 12M18 6L6 18" />
      </svg>
    </button>
  </div>

  <div class="grid gap-6 px-6 py-6 sm:grid-cols-2 sm:px-8">
    <section aria-labelledby="visit-hours-heading" class="rounded-sm bg-sherwood-mint p-5">
      <h3 id="visit-hours-heading" class="flex items-center gap-2 text-[17px] font-bold">
        <HeroIcon name="clock" class="size-5 text-sherwood-leaf" />
        Hours
      </h3>
      <HoursList class="mt-3 [&_dd]:text-sherwood-forest-soft" />
      <p class="mt-4 border-t border-sherwood-forest/10 pt-3 text-[14px] text-sherwood-forest-soft">
        Closed for the season {formatDate(season.closes)}. Reopens {formatDate(season.reopens)}.
      </p>
    </section>

    <section aria-labelledby="visit-directions-heading" class="p-1 sm:p-0">
      <h3 id="visit-directions-heading" class="flex items-center gap-2 text-[17px] font-bold">
        <HeroIcon name="pin" class="size-5 text-sherwood-leaf" />
        Getting here
      </h3>
      <address class="mt-3 text-[15px] not-italic leading-relaxed">
        {business.name}<br />
        {business.street}<br />
        {business.locality}, {business.region}
      </address>
      <!-- TODO: placeholder route; replace with real driving directions. -->
      <p class="mt-3 text-[15px] leading-relaxed text-sherwood-forest-soft">
        <strong class="font-semibold text-sherwood-forest">From Edmonton:</strong> take
        Highway 16 East toward Sherwood Park, exit at Placeholder Road and head south
        for 2 km. The entrance is on the left, with free parking at the front.
      </p>
      <a
        href={business.phoneHref}
        class="mt-3 inline-flex min-h-11 items-center gap-2 text-[15px] font-semibold underline decoration-1 underline-offset-[6px] hover:decoration-2"
      >
        <HeroIcon name="phone" class="size-5 text-sherwood-leaf" />
        {business.phone}
      </a>
    </section>
  </div>

  <div class="flex flex-col gap-3 border-t border-sherwood-forest/10 px-6 py-5 sm:flex-row sm:justify-end sm:px-8">
    <a
      href={mapsLinks.apple}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-12 items-center justify-center rounded-sm border-2 border-sherwood-forest px-5 text-[15px] font-bold transition-colors hover:bg-sherwood-forest/5"
    >
      Open in Apple Maps
    </a>
    <a
      href={mapsLinks.google}
      target="_blank"
      rel="noopener"
      class="inline-flex min-h-12 items-center justify-center rounded-sm bg-sherwood-forest px-5 text-[15px] font-bold text-sherwood-paper transition-colors hover:bg-sherwood-forest-hover"
    >
      Get directions in Google Maps
    </a>
  </div>
</dialog>

<style>
  .visit-dialog,
  .visit-dialog::backdrop {
    opacity: 0;
    transition:
      opacity 180ms ease-out,
      display 180ms allow-discrete,
      overlay 180ms allow-discrete;
  }

  .visit-dialog::backdrop {
    background-color: rgb(20 28 20 / 0.45);
  }

  .visit-dialog[open],
  .visit-dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .visit-dialog[open],
    .visit-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .visit-dialog,
    .visit-dialog::backdrop {
      transition: none;
    }
  }

  :global(html:has(dialog[data-visit-dialog][open])) {
    overflow: hidden;
  }
</style>

<script>
  import { startVisitStatus } from "@/scripts/visit-status";

  startVisitStatus();

  const getDialog = () => document.querySelector<HTMLDialogElement>("[data-visit-dialog]");

  const open = () => {
    const dialog = getDialog();
    if (dialog && !dialog.open) dialog.showModal();
  };

  // Delegated, bound once: any [data-visit-open] on the page opens the dialog.
  document.addEventListener("click", (event) => {
    const trigger = (event.target as Element | null)?.closest("[data-visit-open]");
    if (!trigger) return;
    event.preventDefault();
    const host = trigger.closest("dialog[open]");
    if (host instanceof HTMLDialogElement && host !== getDialog()) {
      host.addEventListener("close", open, { once: true });
    } else {
      open();
    }
  });

  function initVisitDialog() {
    const dialog = getDialog();
    if (!dialog || dialog.dataset.bound) return;
    dialog.dataset.bound = "true";

    dialog
      .querySelectorAll("[data-visit-close]")
      .forEach((btn) => btn.addEventListener("click", () => dialog.close()));

    dialog.addEventListener("click", (event) => {
      if (event.target === dialog) dialog.close();
    });
  }

  initVisitDialog();
  document.addEventListener("astro:page-load", initVisitDialog);
</script>
