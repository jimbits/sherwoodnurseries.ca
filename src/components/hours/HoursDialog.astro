---
/**
 * HoursDialog.astro — an "Hours of operation" button plus the modal it opens.
 * Native <dialog> (focus trap, Esc to close, ::backdrop) with a short CSS
 * fade in/out, matching DirectionsDialog.
 *
 * Pass a `trigger` slot to replace the default button label.
 *
 * <HoursDialog triggerClass="…" />
 * <HoursDialog triggerClass="…"><Fragment slot="trigger">…</Fragment></HoursDialog>
 */
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils/cn";
import HoursList from "./HoursList.astro";

type Props = HTMLAttributes<"div"> & { triggerClass?: string };

const { class: className, triggerClass, ...rest } = Astro.props;

const id = `hours-dialog-${Math.random().toString(36).slice(2, 8)}`;
const titleId = `${id}-title`;
---

<div class={cn("contents", className)} {...rest}>
  <button
    type="button"
    class={triggerClass}
    aria-haspopup="dialog"
    aria-controls={id}
    data-hours-trigger
  >
    <slot name="trigger">Hours of operation</slot>
  </button>

  <dialog
    id={id}
    aria-labelledby={titleId}
    data-hours-dialog
    class="hours-dialog m-auto w-[min(26rem,calc(100%-2rem))] max-h-[calc(100dvh-2rem)] overflow-y-auto rounded-lg border border-border bg-surface p-0 text-ink shadow-float"
  >
    <div class="flex items-start justify-between gap-4 px-6 pt-6">
      <div>
        <p class="text-xs font-bold uppercase tracking-wide text-olive-500">
          Visit the nursery
        </p>
        <h2 id={titleId} class="mt-1 text-xl font-bold text-ink">
          Hours of operation
        </h2>
      </div>
      <button
        type="button"
        data-hours-close
        aria-label="Close hours"
        class="grid size-9 shrink-0 place-items-center rounded-pill text-muted transition-colors hover:bg-primary-tint hover:text-on-primary-tint"
      >
        <svg
          viewBox="0 0 24 24"
          class="size-5"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M6 6l12 12M18 6L6 18" />
        </svg>
      </button>
    </div>

    <div class="space-y-4 px-6 pt-5 pb-6">
      <HoursList />
      <p class="text-sm text-neutral-600">
        Seasonal hours apply November – March.
      </p>
    </div>
  </dialog>
</div>

<style>
  /* Fade the dialog and its backdrop in and out. `allow-discrete` lets
     display/overlay flip *after* the fade-out instead of instantly. */
  .hours-dialog,
  .hours-dialog::backdrop {
    opacity: 0;
    transition:
      opacity 180ms ease-out,
      display 180ms allow-discrete,
      overlay 180ms allow-discrete;
  }

  .hours-dialog::backdrop {
    background-color: rgb(20 28 20 / 0.45);
  }

  .hours-dialog[open],
  .hours-dialog[open]::backdrop {
    opacity: 1;
  }

  @starting-style {
    .hours-dialog[open],
    .hours-dialog[open]::backdrop {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .hours-dialog,
    .hours-dialog::backdrop {
      transition: none;
    }
  }

  /* Stop the page scrolling behind the open modal. */
  :global(html:has(dialog[data-hours-dialog][open])) {
    overflow: hidden;
  }
</style>

<script>
  function initHoursDialogs() {
    document
      .querySelectorAll<HTMLButtonElement>("[data-hours-trigger]")
      .forEach((trigger) => {
        if (trigger.dataset.bound) return;
        trigger.dataset.bound = "true";

        const dialog = document.getElementById(
          trigger.getAttribute("aria-controls") ?? "",
        );
        if (!(dialog instanceof HTMLDialogElement)) return;

        trigger.addEventListener("click", () => dialog.showModal());

        dialog
          .querySelectorAll("[data-hours-close]")
          .forEach((btn) =>
            btn.addEventListener("click", () => dialog.close()),
          );

        // Click on the backdrop (the dialog element itself, outside its content) closes it.
        dialog.addEventListener("click", (event) => {
          if (event.target === dialog) dialog.close();
        });
      });
  }

  initHoursDialogs();
  document.addEventListener("astro:page-load", initHoursDialogs);
</script>
