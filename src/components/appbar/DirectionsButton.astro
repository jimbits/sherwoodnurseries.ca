---
/**
 * GetDirectionsButton.astro — ripple-pin icon, "Get Directions", address below.
 * Values are hard-coded. Opens Google Maps in a new tab.
 *
 * <GetDirectionsButton />
 * <GetDirectionsButton class="text-white" />
 */
import type { HTMLAttributes } from "astro/types";
import { cn } from "@/lib/utils/cn";

type Props = HTMLAttributes<"button">;

const { class: className, ...rest } = Astro.props;
---

<button
  class={cn(
    "cursor-pointer whitespace-nowrap rounded-sm px-3 py-2 no-underline transition-colors hover:bg-sherwood-mint",
    className,
  )}
  {...rest}
>
  <div class="flex items-center gap-1">
    <svg
      class="h-8 w-8 fill-none stroke-2 stroke-sherwood-leaf"
      viewBox="0 0 48 48"
      aria-hidden="true"
    >
      <path d="M24 34s-9-8.5-9-16a9 9 0 0 1 18 0c0 7.5-9 16-9 16z" />
      <circle cx="24" cy="18" r="3.2" />
      <path d="M12 33c-3 1-4.5 2.3-4.5 3.7 0 3 7.4 5.3 16.5 5.3s16.5-2.3 16.5-5.3c0-1.4-1.5-2.7-4.5-3.7" />
      <path d="M18 37.5c1.8.4 3.8.5 6 .5s4.2-.1 6-.5" />
    </svg>
    <div class="flex flex-col items-start">
      <span class="block text-xs font-bold uppercase tracking-[.1px] text-sherwood-forest-soft">
        Get Directions
      </span>
      <span class="block text-[14px] leading-2 font-bold text-sherwood-forest">
        Sherwood Park, Alberta
      </span>
    </div>
  </div>
</button>
