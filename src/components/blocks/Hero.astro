---
// Hero.astro — Sherwood Nurseries full-bleed hero
// Background image: place at /public/images/sherwood-nursery-yard.png
import BrandLogo from "@/components/brand/BrandLogo.astro";
---

<section
  class="relative isolate flex min-h-[100svh] flex-col overflow-hidden bg-neutral-800 font-sans text-neutral-900 lg:min-h-[860px]"
  aria-labelledby="hero-heading"
>
  <!-- Background image + tint -->
  <img
    src="/public/sherwood-nursery-yard.webp"
    alt=""
    class="absolute inset-0 -z-10 h-full w-full object-cover"
    fetchpriority="high"
    decoding="async"
  />
  <div class="absolute inset-0 -z-10 bg-black/55" aria-hidden="true"></div>

  <!-- Main content: centered two columns -->
  <div class="m-auto grid w-full max-w-7xl items-center gap-10 px-6 py-16 sm:px-10 md:py-20 lg:grid-cols-2 lg:gap-16 lg:px-16">
    <!-- Left: heading + CTAs -->
    <div class="flex flex-col gap-6 text-center text-white sm:text-left">
      <div class="flex flex-col items-center gap-1 sm:items-start">
        <BrandLogo class="mb-3 size-16 text-white sm:size-20" label="" />
        <p class="text-sm font-semibold uppercase tracking-[0.12em] text-neutral-200">
          Sherwood Nurseries
        </p>
        <p class="text-base font-medium text-[#cfe8c4]">
          Take Root &amp; Grow Strong
        </p>
      </div>
      <h1
        id="hero-heading"
        class="text-5xl font-bold leading-[1.02] tracking-tight sm:text-6xl xl:text-7xl"
      >
        Everything your garden needs to take root.
      </h1>
      <p class="mx-auto max-w-xl text-lg sm:mx-0 leading-relaxed text-neutral-200 sm:text-xl">
        Walk the rows, talk to our growers, and leave with plants that suit your
        soil, sun and space.
      </p>
      <div class="flex flex-col gap-4 sm:flex-row sm:flex-wrap">
        <a
          href="/shop/trees-shrubs"
          class="inline-flex min-h-12 items-center justify-center rounded-md bg-white px-6 font-semibold text-neutral-900 transition hover:bg-neutral-200 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Shop Trees &amp; Shrubs
        </a>
        <a
          href="/consultation"
          class="inline-flex min-h-12 items-center justify-center rounded-md border-2 border-white px-6 font-semibold text-white transition hover:bg-white/10 focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-white"
        >
          Book a Consultation
        </a>
      </div>
    </div>

    <!-- Right: hours + find us -->
    <div class="mx-auto flex w-full max-w-md flex-col gap-4 sm:max-w-none sm:flex-row lg:max-w-md lg:flex-col">
      <!-- Hours card -->
      <div class="flex flex-1 flex-col gap-3 rounded-xl bg-white p-6">
        <div class="flex flex-wrap items-center justify-between gap-2">
          <h2 class="text-lg font-bold">Hours of operation</h2>
          <span class="inline-flex items-center gap-1.5 rounded-full bg-neutral-200 px-3 py-1 text-xs font-semibold">
            <span
              class="h-2 w-2 rounded-full bg-neutral-800"
              aria-hidden="true"
            ></span>
            Open until 6 PM
          </span>
        </div>
        <dl class="grid grid-cols-[auto_1fr] gap-x-6 gap-y-1.5 text-[15px]">
          <dt class="font-semibold">Mon – Fri</dt>
          <dd class="text-neutral-600">9:00 AM – 6:00 PM</dd>
          <dt class="font-semibold">Saturday</dt>
          <dd class="text-neutral-600">9:00 AM – 5:00 PM</dd>
          <dt class="font-semibold">Sunday</dt>
          <dd class="text-neutral-600">10:00 AM – 4:00 PM</dd>
          <dt class="font-semibold">Holidays</dt>
          <dd class="text-neutral-600">Closed</dd>
        </dl>
        <p class="text-sm text-neutral-600">
          Seasonal hours apply November – March.
        </p>
      </div>

      <!-- Find us card -->
      <div class="flex flex-1 flex-col gap-3 rounded-xl bg-white p-6">
        <h2 class="text-lg font-bold">Find us</h2>
        <iframe
          src="https://www.google.com/maps?q=22040+Township+Rd+522,+Sherwood+Park,+AB&z=14&output=embed"
          title="Map showing Sherwood Park Tree Nursery at 22040 Township Rd 522, Sherwood Park, AB"
          class="h-48 w-full rounded-lg border border-neutral-300 bg-neutral-200"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"
          allowfullscreen
        ></iframe>
        <address class="not-italic text-[15px]">
          22040 Township Rd 522<br />
          Sherwood Park, AB
        </address>
        <div class="flex flex-wrap gap-4 text-[15px] font-semibold">
          <a
            href="https://www.google.com/maps/dir/?api=1&destination=22040+Township+Rd+522%2C+Sherwood+Park%2C+AB"
            target="_blank"
            rel="noopener noreferrer"
            class="underline-offset-4 hover:underline"
          >
            Get directions →<span class="sr-only"> (opens in a new tab)</span>
          </a>
          <a href="tel:+15875456929" class="underline-offset-4 hover:underline">
            Call 587-545-6929
          </a>
        </div>
      </div>
    </div>
  </div>

  <!-- Bottom CTA bar -->
  <nav
    aria-label="Shop categories"
    class="relative w-full border-t border-neutral-300 bg-white"
  >
    <ul class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4">
      <li class="border-b border-neutral-200 sm:border-r lg:border-b-0">
        <a
          href="/shop/trees"
          class="flex min-h-16 items-center justify-between px-6 py-5 text-[17px] font-semibold transition hover:bg-neutral-100 sm:px-10 lg:px-16"
        >
          Shop Trees <span aria-hidden="true">→</span>
        </a>
      </li>
      <li class="border-b border-neutral-200 lg:border-b-0 lg:border-r">
        <a
          href="/shop/shrubs"
          class="flex min-h-16 items-center justify-between px-6 py-5 text-[17px] font-semibold transition hover:bg-neutral-100 sm:px-8"
        >
          Shop Shrubs <span aria-hidden="true">→</span>
        </a>
      </li>
      <li class="border-b border-neutral-200 sm:border-b-0 sm:border-r">
        <a
          href="/shop/perennials"
          class="flex min-h-16 items-center justify-between px-6 py-5 text-[17px] font-semibold transition hover:bg-neutral-100 sm:px-10 lg:px-8"
        >
          Shop Perennials <span aria-hidden="true">→</span>
        </a>
      </li>
      <li>
        <a
          href="/whats-new"
          class="flex min-h-16 items-center justify-between bg-neutral-100 px-6 py-5 text-[17px] font-semibold transition hover:bg-neutral-200 sm:px-8"
        >
          What's new this week <span aria-hidden="true">→</span>
        </a>
      </li>
    </ul>
  </nav>
</section>
