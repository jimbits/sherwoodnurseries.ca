---
/**
 * Hero.astro — home page hero (was draft B, "split screen").
 * Mint text half on the left; photo runs edge-to-edge on the right. Stacks
 * below lg. Plant Finder and Plan your visit open from links in HeroIntro.
 */
import { Picture } from "astro:assets";
import HeroIntro from "./HeroIntro.astro";
import photo from "@/assets/placeholder/landscape-ideas.jpeg";
---

<section
  aria-labelledby="hero-heading"
  class="relative grid bg-sherwood-mint lg:min-h-[680px] lg:grid-cols-2"
>
  <div
    class="flex items-center px-4 py-14 sm:px-8 sm:py-20 lg:py-16 lg:pl-12 lg:pr-16 xl:pl-24"
  >
    <HeroIntro headingId="hero-heading" class="w-full max-w-[40rem] lg:ml-auto" />
  </div>

  <div class="relative min-h-[320px] sm:min-h-[420px]">
    <Picture
      src={photo}
      formats={["avif", "webp"]}
      widths={[640, 960, 1440]}
      sizes="(min-width: 1024px) 50vw, 100vw"
      alt="Perennial border with rocks and a tipped terracotta pot spilling flowers"
      loading="eager"
      fetchpriority="high"
      class="absolute inset-0 size-full object-cover"
    />
  </div>
</section>
