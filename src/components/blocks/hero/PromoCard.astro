---
/**
 * PromoCard.astro — tinted link card, from
 * design/reference/example-cards-right-column.png: leaf eyebrow, title,
 * underlined text link pinned to the bottom, photo on the right.
 *
 * The whole card is clickable (stretched link) but only the text link is in
 * the tab order / accessibility tree, so it reads as one link.
 *
 * <PromoCard tint="lavender" eyebrow="New this week" title="…" href="…"
 *   linkLabel="View collection" image={photo} />
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { cn } from "@/lib/utils/cn";
import HeroIcon from "./HeroIcon.astro";

type Props = {
  tint: "sage" | "lavender" | "peach" | "mint";
  eyebrow: string;
  title: string;
  href: string;
  linkLabel: string;
  image?: ImageMetadata;
  /** sm: compact row card · lg: tall feature card */
  size?: "sm" | "lg";
  /** Optional supporting line under the title (lg cards). */
  body?: string;
  class?: string;
};

const {
  tint,
  eyebrow,
  title,
  href,
  linkLabel,
  image,
  size = "sm",
  body,
  class: className,
} = Astro.props;

const tints = {
  sage: "bg-sherwood-sage",
  lavender: "bg-sherwood-lavender",
  peach: "bg-sherwood-peach",
  mint: "bg-sherwood-mint-deep",
};
---

<article
  class={cn(
    "group relative isolate flex overflow-hidden rounded-sm text-sherwood-forest",
    tints[tint],
    size === "lg" ? "min-h-[22rem] p-7 sm:p-10" : "min-h-[11rem] p-6",
    className,
  )}
>
  <div
    class={cn(
      "relative z-10 flex flex-col",
      image ? (size === "lg" ? "max-w-[55%]" : "max-w-[60%]") : "max-w-full",
    )}
  >
    <p class="flex items-center gap-2 text-[14px] font-semibold">
      <HeroIcon name="leaf" class="size-4 text-sherwood-forest/70" />
      {eyebrow}
    </p>
    <h2
      class={cn(
        "mt-2 font-bold leading-tight text-balance",
        size === "lg" ? "text-[30px] sm:text-[36px]" : "text-[20px]",
      )}
    >
      {title}
    </h2>
    {body && <p class="mt-3 text-[16px] leading-relaxed text-sherwood-forest-soft">{body}</p>}
    <a
      href={href}
      class="mt-auto inline-flex min-h-11 items-end pt-5 text-[16px] font-semibold underline decoration-1 underline-offset-[6px] transition-[text-decoration-thickness] after:absolute after:inset-0 after:content-[''] hover:decoration-2"
    >
      {linkLabel}
    </a>
  </div>

  {
    image && (
      <Picture
        src={image}
        formats={["avif", "webp"]}
        widths={size === "lg" ? [400, 800] : [240, 480]}
        sizes={size === "lg" ? "(min-width: 1024px) 380px, 45vw" : "(min-width: 1024px) 220px, 40vw"}
        alt=""
        class={cn(
          "absolute inset-y-0 right-0 -z-10 h-full object-cover transition-transform duration-500 group-hover:scale-[1.03]",
          size === "lg" ? "w-[45%]" : "w-[38%]",
          "[mask-image:linear-gradient(to_right,transparent,black_35%)]",
        )}
      />
    )
  }
</article>
