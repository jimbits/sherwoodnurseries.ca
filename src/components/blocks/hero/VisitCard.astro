---
/**
 * VisitCard.astro — "Plan your visit": live open/closed status, hours and
 * directions. Styled after the product cards in
 * design/reference/presentation-cards-for-hours and directions.png:
 * white card, hairline border, inset photo on a pale well, small badge
 * top-left, title + meta below.
 *
 * <VisitCard />                       photo + status + links
 * <VisitCard image={false} showHours />  text-only, with the weekly hours
 */
import type { ImageMetadata } from "astro";
import { Picture } from "astro:assets";
import { cn } from "@/lib/utils/cn";
import { getVisitStatus } from "@/data/hours";
import { business } from "@/data/business";
import HoursDialog from "@/components/hours/HoursDialog.astro";
import DirectionsDialog from "@/components/appbar/DirectionsDialog.astro";
import HoursList from "@/components/hours/HoursList.astro";
import HeroIcon from "./HeroIcon.astro";
import yardPhoto from "@/assets/placeholder/hero-landscape.jpg";

type Props = {
  image?: ImageMetadata | false;
  showHours?: boolean;
  class?: string;
};

const { image = yardPhoto, showHours = false, class: className } = Astro.props;

const status = getVisitStatus(); // build-time; refreshed by the script below
const badge = (open: boolean) => (open ? "Open now" : "Closed");

const link =
  "inline-flex min-h-11 items-center gap-2 text-[15px] font-semibold text-sherwood-forest underline decoration-1 underline-offset-[6px] hover:decoration-2";
---

<article
  class={cn(
    "group/visit rounded-sm border border-sherwood-forest/10 bg-sherwood-paper p-2.5 text-sherwood-forest shadow-[0_1px_2px_rgb(0_0_0/0.04)]",
    className,
  )}
  data-visit-status
  data-open={String(status.open)}
>
  {
    image && (
      <div class="relative overflow-hidden rounded-[8px] bg-sherwood-mint-deep">
        <Picture
          src={image}
          formats={["avif", "webp"]}
          widths={[480, 960]}
          sizes="(min-width: 1024px) 460px, 100vw"
          alt="Rows of potted trees along a gravel path at the nursery"
          class="aspect-[16/7] w-full object-cover"
        />
        <span
          class="absolute left-2.5 top-2.5 rounded-[6px] bg-sherwood-lime-tint px-2.5 py-1 text-[13px] font-bold text-sherwood-forest"
          data-visit-badge
        >
          {badge(status.open)}
        </span>
      </div>
    )
  }

  <div class="px-2.5 pb-1.5 pt-4">
    <h2 class="text-[20px] font-bold leading-tight">Plan your visit</h2>
    <p class="mt-2 flex items-start gap-2.5 text-[15px]">
      <span
        class="mt-[0.4em] size-2.5 shrink-0 rounded-full border-2 border-sherwood-leaf group-data-[open=true]/visit:bg-sherwood-leaf"
        aria-hidden="true"></span>
      <span>
        <span data-visit-label class="font-semibold">{status.label}</span>
        <span aria-hidden="true"> · </span>
        <span data-visit-detail class="text-sherwood-forest-soft">{status.detail}</span>
      </span>
    </p>

    {showHours && <HoursList class="mt-4 border-t border-sherwood-forest/10 pt-4 text-sherwood-forest [&_dd]:text-sherwood-forest-soft" />}

    <p class="mt-1 text-[15px] text-sherwood-forest-soft">
      {business.street}, {business.locality}
    </p>

    <div class="mt-1 flex flex-wrap gap-x-6">
      <DirectionsDialog triggerClass={cn(link, "cursor-pointer")}>
        <Fragment slot="trigger">
          <HeroIcon name="pin" class="size-5 text-sherwood-leaf" />
          Get directions
        </Fragment>
      </DirectionsDialog>
      <HoursDialog triggerClass={cn(link, "cursor-pointer")}>
        <Fragment slot="trigger">
          <HeroIcon name="clock" class="size-5 text-sherwood-leaf" />
          All hours
        </Fragment>
      </HoursDialog>
    </div>
  </div>
</article>

<script>
  // Refresh status in the browser so a cached page never shows a stale state.
  import { getVisitStatus } from "@/data/hours";

  function render() {
    const s = getVisitStatus();
    document.querySelectorAll<HTMLElement>("[data-visit-status]").forEach((el) => {
      el.dataset.open = String(s.open);
      const set = (sel: string, text: string) => {
        const node = el.querySelector(sel);
        if (node) node.textContent = text;
      };
      set("[data-visit-label]", s.label);
      set("[data-visit-detail]", s.detail);
      set("[data-visit-badge]", s.open ? "Open now" : "Closed");
    });
  }

  render();
  setInterval(render, 60_000);
</script>
