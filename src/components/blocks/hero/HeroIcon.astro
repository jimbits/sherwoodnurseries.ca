---
/**
 * HeroIcon.astro — line icons for the hero drafts (decorative, aria-hidden).
 * `leaf` is filled (eyebrow marker); the rest are 1.5px strokes like the
 * feature icons in design/reference/example-left-column.png.
 *
 * <HeroIcon name="sprout" class="size-9 text-sherwood-leaf" />
 */
import { cn } from "@/lib/utils/cn";

type Name = "leaf" | "sprout" | "truck" | "arrow" | "pin" | "clock" | "phone" | "search";
type Props = { name: Name; class?: string };

const { name, class: className } = Astro.props;
---

<svg
  viewBox="0 0 24 24"
  class={cn(
    "shrink-0",
    name === "leaf" ? "fill-current" : "fill-none stroke-current stroke-[1.5]",
    className,
  )}
  stroke-linecap="round"
  stroke-linejoin="round"
  aria-hidden="true"
>
  {name === "leaf" && <path d="M20 4c-9 0-15 4.5-15 11 0 1.6.5 3 1.3 4.1C8 14 11.5 10.6 16 9c-4 2.4-7 5.8-8.4 10.4C8.6 19.8 9.8 20 11 20c6 0 9-6 9-16z" />}
  {
    name === "sprout" && (
      <>
        <path d="M6 14h12l-1.5 7h-9z" />
        <path d="M12 14V8" />
        <path d="M12 9c0-3 2-5 6-5 0 3-2 5-6 5z" />
        <path d="M12 11C12 8.5 10.5 7 7 7c0 2.5 1.5 4 5 4z" />
      </>
    )
  }
  {
    name === "truck" && (
      <>
        <path d="M3 6h11v10H3z" />
        <path d="M14 10h4l3 3v3h-7z" />
        <circle cx="7" cy="18" r="1.8" />
        <circle cx="17.5" cy="18" r="1.8" />
      </>
    )
  }
  {name === "arrow" && <path d="M4 12h16M14 6l6 6-6 6" />}
  {
    name === "pin" && (
      <>
        <path d="M12 21s-7-6.1-7-11.5a7 7 0 0 1 14 0C19 14.9 12 21 12 21z" />
        <circle cx="12" cy="9.5" r="2.5" />
      </>
    )
  }
  {
    name === "clock" && (
      <>
        <circle cx="12" cy="12" r="9" />
        <path d="M12 7v5l3 2" />
      </>
    )
  }
  {
    name === "search" && (
      <>
        <circle cx="10.5" cy="10.5" r="6.5" />
        <path d="M15.5 15.5 20 20" />
      </>
    )
  }
  {name === "phone" && <path d="M5 4h4l2 5-2.5 1.5a11 11 0 0 0 5 5L15 13l5 2v4a2 2 0 0 1-2 2A16 16 0 0 1 3 6a2 2 0 0 1 2-2z" />}
</svg>
