---
/**
 * PlantFinderCard.astro — hero teaser for the Plant Finder. Same shell as
 * VisitCard so the two read as a pair in the hero's bridge strip. The button
 * opens PlantFinderDialog (rendered once in Layout.astro).
 *
 * <PlantFinderCard class="shadow-float" />
 */
import { cn } from "@/lib/utils/cn";
import { popularSearches } from "@/data/plant-finder";
import HeroIcon from "./HeroIcon.astro";

type Props = { class?: string };
const { class: className } = Astro.props;

const link =
  "inline-flex min-h-11 items-center text-[15px] font-semibold text-sherwood-forest underline decoration-1 underline-offset-[6px] hover:decoration-2";
---

<article
  class={cn(
    "flex flex-col rounded-sm border border-sherwood-forest/10 bg-sherwood-paper p-2.5 text-sherwood-forest shadow-[0_1px_2px_rgb(0_0_0/0.04)]",
    className,
  )}
>
  <div class="flex flex-1 flex-col px-2.5 pb-1.5 pt-4">
    <p class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-wider">
      <HeroIcon name="leaf" class="size-4 text-sherwood-leaf" />
      Plant finder
    </p>
    <h2 class="mt-1.5 text-[20px] font-bold leading-tight">Find the right plant</h2>
    <p class="mt-2 text-[15px] text-sherwood-forest-soft">
      Hardy to zone 3. Filter by type, sun and size.
    </p>

    <button
      type="button"
      data-plant-finder-open
      aria-haspopup="dialog"
      aria-controls="plant-finder-dialog"
      class="mt-4 inline-flex min-h-12 w-full cursor-pointer items-center justify-between gap-3 rounded-sm border border-sherwood-forest/25 bg-sherwood-mint px-4 text-left text-[16px] text-sherwood-forest-soft transition-colors hover:border-sherwood-forest/50 hover:bg-sherwood-mint-deep"
    >
      <span class="flex items-center gap-2.5">
        <HeroIcon name="search" class="size-5 text-sherwood-leaf" />
        What are you looking for?
      </span>
      <span class="rounded-sm bg-sherwood-forest px-3 py-1.5 text-[14px] font-bold text-sherwood-paper">
        Start
      </span>
    </button>

    <div class="mt-1 flex flex-wrap gap-x-5">
      {popularSearches.slice(0, 3).map((s) => <a href={s.href} class={link}>{s.label}</a>)}
    </div>
  </div>
</article>
