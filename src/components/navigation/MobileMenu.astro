---
/**
 * MobileMenu.astro — hamburger button that opens a full-viewport <dialog>.
 * Fades in on open and fades out on close (button, link click or Escape).
 *
 * <MobileMenu class="sm:hidden" />
 * <MobileMenu links={[{ label: "Home", href: "/" }]} />
 */
import { cn } from "@/lib/utils/cn";
import Logo from "@/assets/brand/logo-5.svg";

interface NavLink {
  label: string;
  href: string;
}

interface Props {
  links?: NavLink[];
  currentPath?: string;
  phone?: string;
  email?: string;
  class?: string;
}

const {
  links = [
    { label: "Home", href: "/" },
    { label: "Services", href: "/services" },
    { label: "Shop", href: "/shop" },
    { label: "Guide", href: "/guide" },
    { label: "Blog", href: "/blog" },
    { label: "Contact", href: "/contact" },
  ],
  currentPath = Astro.url.pathname,
  phone = "(587)-545-6929",
  email = "info@sherwoodnurseries.ca",
  class: className,
} = Astro.props;

const MAP_URL =
  "https://www.google.com/maps/search/?api=1&query=22040+Township+Rd+522%2C+Sherwood+Park%2C+AB";

const isActive = (href: string): boolean =>
  href === "/" ? currentPath === "/" : currentPath.startsWith(href);
---

<div class={cn("contents", className)} data-mobile-menu>
  <button
    type="button"
    class="flex size-11 items-center justify-center rounded-md text-olive-950 hover:bg-[#e0face]"
    aria-label="Open menu"
    aria-haspopup="dialog"
    aria-expanded="false"
    data-menu-open
  >
    <svg
      width="26"
      height="26"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
    >
      <path d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
  </button>

  <dialog
    class="mobile-menu m-0 size-full max-h-none max-w-none bg-white/90 p-5 text-olive-950 backdrop-blur-md"
    aria-label="Site menu"
    data-menu
  >
    <div class="flex h-full flex-col">
      <div class="flex items-center justify-between">
        <a href="/" class="flex min-w-0 items-center gap-3" aria-label="Sherwood Nursery home">
          <Logo class="size-12 shrink-0" aria-hidden="true" />
          <span class="min-w-0 leading-tight">
            <span class="block text-lg font-bold">Sherwood Nursery</span>
            <span class="block text-sm font-medium text-olive-700">Take Root &amp; Grow Strong</span>
          </span>
        </a>
        <button
          type="button"
          class="flex size-11 items-center justify-center rounded-md hover:bg-[#e0face]"
          aria-label="Close menu"
          data-menu-close
        >
          <svg
            width="24"
            height="24"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
          >
            <path d="M6 6l12 12M18 6L6 18"></path>
          </svg>
        </button>
      </div>

      <!-- Group 1: contact links -->
      <ul class="mt-5 flex flex-col border-b border-olive-950/15 pb-3">
        <li>
          <a href={`tel:${phone.replace(/\D/g, "")}`} class="menu-link">
            <span class="menu-label">Call us</span>
            <span class="menu-detail">{phone}</span>
          </a>
        </li>
        <li>
          <a href={`mailto:${email}`} class="menu-link">
            <span class="menu-label">Email us</span>
            <span class="menu-detail">{email}</span>
          </a>
        </li>
        <li>
          <a href={MAP_URL} target="_blank" rel="noopener noreferrer" class="menu-link">
            <span class="menu-label">Get directions</span>
            <span class="menu-detail">Sherwood Park, Alberta</span>
            <span class="sr-only">(opens in a new tab)</span>
          </a>
        </li>
      </ul>

      <!-- Group 2: page links -->
      <nav class="pt-3" aria-label="Mobile">
        <ul class="flex flex-col">
          {
            links.map((l) => (
              <li>
                <a
                  href={l.href}
                  aria-current={isActive(l.href) ? "page" : undefined}
                  class="menu-link"
                >
                  <span class="menu-label">{l.label}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

    </div>
  </dialog>
</div>

<style>
  .mobile-menu {
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .mobile-menu[open] {
    opacity: 1;
  }
  .mobile-menu[open][data-closing] {
    opacity: 0;
  }
  /* Fade in from 0 when the dialog first opens */
  @starting-style {
    .mobile-menu[open] {
      opacity: 0;
    }
  }
  /* Shared style for both link groups */
  .menu-link {
    display: block;
    padding-block: 0.625rem;
  }
  .menu-label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 700;
    letter-spacing: 0.03em;
    text-transform: uppercase;
  }
  .menu-detail {
    display: block;
    font-size: 0.875rem;
    opacity: 0.75;
  }
  .menu-link:hover .menu-label,
  .menu-link[aria-current="page"] .menu-label {
    color: #2b8a2e;
  }
  .mobile-menu::backdrop {
    background: transparent;
  }
  @media (prefers-reduced-motion: reduce) {
    .mobile-menu {
      transition: none;
    }
  }
</style>

<script>
  const FADE_MS = 250;

  function initMobileMenu(): void {
    document.querySelectorAll<HTMLElement>("[data-mobile-menu]").forEach((root) => {
      if (root.dataset.ready) return;
      root.dataset.ready = "true";

      const dialog = root.querySelector<HTMLDialogElement>("[data-menu]");
      const openBtn = root.querySelector<HTMLButtonElement>("[data-menu-open]");
      const closeBtn = root.querySelector<HTMLButtonElement>("[data-menu-close]");
      if (!dialog || !openBtn || !closeBtn) return;

      const open = (): void => {
        dialog.removeAttribute("data-closing");
        dialog.showModal();
        openBtn.setAttribute("aria-expanded", "true");
        document.documentElement.style.overflow = "hidden";
      };

      const close = (): void => {
        if (!dialog.open || dialog.hasAttribute("data-closing")) return;
        dialog.setAttribute("data-closing", "");

        const reduce = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
        window.setTimeout(() => {
          dialog.close();
          dialog.removeAttribute("data-closing");
        }, reduce ? 0 : FADE_MS);
      };

      dialog.addEventListener("close", () => {
        openBtn.setAttribute("aria-expanded", "false");
        document.documentElement.style.overflow = "";
        openBtn.focus();
      });

      // Escape: run the fade-out instead of closing instantly
      dialog.addEventListener("cancel", (e) => {
        e.preventDefault();
        close();
      });

      openBtn.addEventListener("click", open);
      closeBtn.addEventListener("click", close);
      dialog.querySelectorAll("a").forEach((a) => a.addEventListener("click", close));
    });
  }

  initMobileMenu();
  document.addEventListener("astro:after-swap", initMobileMenu);
</script>
