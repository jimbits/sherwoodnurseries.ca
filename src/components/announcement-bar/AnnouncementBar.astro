---
/**
 * AnnouncementBar.astro — Sherwood Nursery announcement strip
 * Desktop (>=900px): message centred, status on the right.
 * Mobile (<900px): status only.
 *
 * Usage:
 * <AnnouncementBar
 *   message="Thank you to all our loyal customers for such a great season this year"
 *   status="Currently Closed Will Reopen September 2027"
 * />
 */
interface Props {
  /** Centred text, e.g. a thank-you or promo line */
  message?: string;
  /** Open/closed status, e.g. "Currently Closed Will Reopen September 2027" */
  status?: string;
  class?: string;
}

const {
  message = "Thank you to all our loyal customers for such a great season this year Currently Closed Will Reopen September 2027",
  status = "Currently Closed Will Reopen September 2027",
  class: className,
} = Astro.props;
---

<div
  class:list={[
    "grid h-[38px] grid-cols-[minmax(0,1fr)_auto] items-center gap-x-6 whitespace-nowrap bg-[#e3efd9] px-6 text-[13px] font-medium text-[#0f4b39]",
    "min-[900px]:grid-cols-[minmax(max-content,1fr)_auto_minmax(max-content,1fr)]",
    className,
  ]}
  role="region"
  aria-label="Announcement"
>
  <!-- Left spacer keeps the message centred on desktop -->
  <span class="hidden min-[900px]:block" aria-hidden="true"></span>
  <p class="m-0 hidden font-semibold min-[900px]:block">{message}</p>
  <p class="m-0 truncate min-[900px]:justify-self-end">{status}</p>
  <!-- Mobile only: phone moves up here while the main bar shows the menu button -->
  <a
    href="tel:5875456929"
    class="flex items-center gap-1 font-semibold text-[#0f4b39] hover:underline sm:hidden"
  >
    <svg
      width="14"
      height="14"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      stroke-linejoin="round"
      aria-hidden="true"
    >
      <path
        d="M22 16.9v3a2 2 0 0 1-2.2 2 19.8 19.8 0 0 1-8.6-3.1 19.5 19.5 0 0 1-6-6A19.8 19.8 0 0 1 2.1 4.2 2 2 0 0 1 4.1 2h3a2 2 0 0 1 2 1.7c.1 1 .4 1.9.7 2.8a2 2 0 0 1-.5 2.1L8 9.9a16 16 0 0 0 6 6l1.3-1.3a2 2 0 0 1 2.1-.4c.9.3 1.8.6 2.8.7a2 2 0 0 1 1.7 2z"
      ></path>
    </svg>
    (587) 545-6929
  </a>
</div>
