---
import { cn } from "@/lib/utils/cn.ts";

const {
  slug,
  name,
  description,
  price,
  class: className,
  ...rest
} = Astro.props;
---

<section class={cn("bg-mist-100 py-8 px-4 rounded-2xl min-h-28", className)}>
  <header><h3 class="font-semibold font-lg">Product name</h3></header>
  <p>{description}</p>
  <p>{price}</p>
  <p>slug</p>
</section>
