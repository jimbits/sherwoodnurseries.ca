---
// src/components/ui/BrandLogo.astro
// Inline Company Brand Logo
import type { ComponentProps } from "astro/types";
import Logo from "./logo.svg";
import { cn } from "@/lib/utils/cn";

interface Props {
  class?: string;
  label?: string;
}

const { label = "Sherwood Nursery", class: className, ...rest } = Astro.props;
---

<Logo
  class={cn("w-10 h-10 fill-current", className)}
  role={label ? "img" : undefined}
  aria-label={label || undefined}
  aria-hidden={label ? undefined : "true"}
  focusable="false"
  {...rest}
/>
