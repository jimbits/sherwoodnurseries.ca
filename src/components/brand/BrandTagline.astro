---
import type { ComponentProps } from "astro/types";

import { cn } from "@/lib/utils/cn";

const DEFAULT_TAGLINE = "take root & grow strong";

interface Props {
  class?: string;
  label?: string;
}

const { label = DEFAULT_TAGLINE, class: className, ...rest } = Astro.props;
---

<p
  class={cn("text-current ", className)}

  {...rest}
>
  <slot>{label}</slot>
</p>
