---
import "@/css/global.css";
import AnnouncementBar from "@/components/announcement-bar/AnnouncementBar.astro";
import PageModeScript from "@/components/page-mode/PageModeScript.astro";
import Hero from "@/components/blocks/hero/Hero.astro";
import AppBar from "@/components/appbar/AppBar.astro";
import PlantFinderDialog from "@/components/plant-finder/PlantFinderDialog.astro";
import VisitDialog from "@/components/hours/VisitDialog.astro";
import BookConsultationForm from "@/components/consultation/BookConsultationForm.astro";

// hero={false} lets a page render its own hero (e.g. /hero-drafts).
const { hero = true } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Sherwood Nursery | Welcome</title>
    <PageModeScript />
    <slot name="head" />
  </head>
  <body>
    <!-- Phones: site navigation, then announcement bar. 640px+: announcement bar on top. -->
    <div class="flex flex-col">
      <AnnouncementBar class="order-2 sm:order-1" />
      <AppBar />
    </div>
    {hero && <Hero />}
    <slot />
    <PlantFinderDialog />
    <VisitDialog />
    <BookConsultationForm />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
