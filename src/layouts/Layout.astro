---
import SiteNavigationBar from "@/components/blocks/navigation-bar/SiteNavigationBar.astro";
import "../styles/global.css";
import AnnouncementBar from "@/components/blocks/announcement-bar/AnnouncementBar.astro";
import BrandLogo from "@/components/brand/BrandLogo.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <AnnouncementBar />
    <SiteNavigationBar />

    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
    background-color: #eef9fa;
  }
</style>
