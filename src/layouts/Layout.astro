---
import AnnouncementBar from "@/components/blocks/announcement-bar/AnnouncementBar.astro";

import "../styles/global.css";
import SeasonStatus from "@/components/blocks/announcement-bar/SeasonStatus.astro";
import Message from "@/components/blocks/announcement-bar/Message.astro";
import Badge from "@/ui/badge/Badge.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Astro Basics</title>
  </head>
  <body>
    <AnnouncementBar class="flex justify-center">
      <Message>Closed For The Season</Message>
      <Badge />
    </AnnouncementBar>
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
