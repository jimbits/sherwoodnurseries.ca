---
import SiteNavigationBar from "@/components/navigation-bar/SiteNavigationBar.astro";
import "@/css/global.css";
import AnnouncementBar from "@/components/announcement-bar/AnnouncementBar.astro";

import PageModeScript from "@/components/page-mode/PageModeScript.astro";
import Brand from "@/components/brand/Brand.astro";
import TreeLogo from "@/components/brand/TreeLogo.astro";
import BrandText from "@/components/brand/BrandText.astro";
import BrandTagline from "@/components/brand/BrandTagline.astro";
import BrandLogo from "@/components/brand/BrandLogo.astro";
import PhoneButton from "@/components/navigation-bar/PhoneButton.astro";
import EmailButton from "@/components/navigation-bar/EmailButton.astro";
import DirectionsButton from "@/components/navigation-bar/DirectionsButton.astro";
import MobileMenu from "@/components/navigation-bar/MobileMenu.astro";
import Hero from "@/components/blocks/Hero.astro";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <!-- SVG Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <title>Sherwood Nurseries | Welcome</title>
    <PageModeScript />
  </head>
  <body>
    <!-- Phones: site navigation, then announcement bar. 640px+: announcement bar on top. -->
    <div class="flex flex-col">
    <AnnouncementBar class="order-2 sm:order-1" />
    <div
      class="order-1 flex items-center justify-between gap-4 bg-white px-4 py-3 sm:order-2 sm:px-6 md:py-4 lg:px-8"
    >
      <Brand class="flex min-w-0 items-center">
        <!-- Text hidden on phones; it shows in the mobile menu header instead -->
        <figcaption class="hidden min-w-0 leading-tight sm:block">
          <BrandText
            class="text-base font-bold text-olive-950 sm:text-lg sm:whitespace-nowrap"
          >
            Sherwood Park Tree Nursery
          </BrandText>
          <BrandTagline
            class="text-xs font-medium tracking-tight text-olive-700 sm:text-sm"
          >
            Take Root & Grow Strong
          </BrandTagline>
        </figcaption>
      </Brand>

      <div class="flex shrink-0 items-center gap-6 xl:gap-12">
        <DirectionsButton class="hidden xl:flex" />
        <EmailButton class="hidden lg:block" />
        <PhoneButton class="hidden sm:flex" />
        <MobileMenu class="sm:hidden" />
      </div>
    </div>
    </div>
    <Hero />
    <slot />
  </body>
</html>

<style>
  html,
  body {
    margin: 0;
    width: 100%;
    height: 100%;
  }
</style>
