---
/**
 * /plant-finder — stub results page for the Plant Finder dialog.
 * There is no plant data yet, so this echoes the chosen filters and points
 * people to the phone. Filters are read in the browser (static site).
 * Replace with real results once the plant content source is decided.
 */
import Layout from "@/layouts/Layout.astro";
import HeroIcon from "@/components/blocks/hero/HeroIcon.astro";
import { finderFields } from "@/data/plant-finder";
import { business } from "@/data/business";
---

<Layout hero={false}>
  <meta slot="head" name="robots" content="noindex" />
  <main class="bg-sherwood-mint px-4 py-16 text-sherwood-forest sm:px-8 sm:py-24">
    <div class="mx-auto max-w-[44rem]">
      <p class="flex items-center gap-2 text-[13px] font-semibold uppercase tracking-wider">
        <HeroIcon name="leaf" class="size-4 text-sherwood-leaf" />
        Plant finder
      </p>
      <h1 class="mt-3 text-[36px] font-bold leading-tight tracking-tight sm:text-[48px]">
        Your plant search
      </h1>

      <p class="mt-6 text-[17px]">
        You searched for:
        <strong data-finder-summary>Any plant · Any light · Any size</strong>
      </p>

      <div class="mt-8 rounded-sm border border-sherwood-forest/10 bg-sherwood-paper p-6 shadow-float sm:p-8">
        <h2 class="text-[22px] font-bold leading-tight">Online results are coming soon</h2>
        <p class="mt-3 text-[16px] leading-relaxed text-sherwood-forest-soft">
          Our inventory changes through the season, so the quickest way to see what's
          hardy, in stock and ready to plant is to give us a call. Our growers are happy
          to help you choose.
        </p>
        <div class="mt-6 flex flex-col gap-3 sm:flex-row">
          <a
            href={business.phoneHref}
            class="inline-flex min-h-[52px] items-center justify-center gap-2 rounded-sm bg-sherwood-forest px-7 text-[17px] font-bold text-sherwood-paper transition-colors hover:bg-sherwood-forest-hover"
          >
            <HeroIcon name="phone" class="size-5" />
            Call {business.phone}
          </a>
          <button
            type="button"
            data-plant-finder-open
            aria-haspopup="dialog"
            aria-controls="plant-finder-dialog"
            class="inline-flex min-h-[52px] cursor-pointer items-center justify-center gap-2 rounded-sm border-2 border-sherwood-forest px-7 text-[17px] font-bold transition-colors hover:bg-sherwood-forest/5"
          >
            <HeroIcon name="search" class="size-5" />
            Change search
          </button>
        </div>
      </div>
    </div>
  </main>
</Layout>

<script define:vars={{ finderFields }}>
  const params = new URLSearchParams(window.location.search);
  const parts = finderFields.map((field) => {
    const value = params.get(field.name);
    const match = field.options.find((o) => o.value === value);
    return match ? match.label : field.anyLabel;
  });
  const summary = document.querySelector("[data-finder-summary]");
  if (summary) summary.textContent = parts.join(" · ");

  // Pre-fill the dialog so "Change search" starts from the current filters.
  for (const field of finderFields) {
    const value = params.get(field.name);
    const select = document.querySelector(
      `[data-plant-finder-dialog] select[name="${field.name}"]`,
    );
    if (select && value) select.value = value;
  }
</script>
